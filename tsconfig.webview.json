{
	"compilerOptions": {
		"module": "ES2022",
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM"
		],
		"sourceMap": true,
		"rootDir": ".",
		"outDir": "out/media",
		"strict": true,
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "preact"
	},
	"include": ["media/**/*", "src/protocol.ts", "src/shared/**/*.ts"],
	"exclude": ["node_modules"]
}
